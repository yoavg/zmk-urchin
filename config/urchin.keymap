#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
//#include "keymap_french.h"


// Layer definitions
/*
#define BASE 0
#define SHT 1
#define ACCENT 2
#define NUM 3
#define EXT 4
#define FNC 5
#define SETTINGS 6
*/
// -----------------

	
&sk {
	// don't release mods on other mods presses
	ignore-modifiers;
};


/ {
      behaviors {
          mt: mod_tap {
            flavor = "balanced";
            tapping-term-ms = <250>;
          };
      };


	keymap {
		compatible = "zmk,keymap";
		// Base alpha layer
		default_layer {
			display-name = "Base";
			bindings = <
            &lt 3 Q        &kp W        &kp E       &kp R       &kp T           &kp Y       &kp U        &kp I       &kp O          &lt 3 P
            &lt 2 A        &kp S        &kp D       &kp F       &kp G           &kp H       &kp J        &kp K       &kp L          &lt 2 SPACE
            &mt RSHFT TAB  &mt LCTRL Z  &mt LALT X  &mt LWIN C  &lt 1 V		&lt 1 B     &mt RWIN N   &mt RALT M  &mt RCTL COMMA &mt RSHFT DOT
						    &kp ESC	&lt 1 SPACE     &lt 1 SPACE &mo 2
			>;
		};
		fn1_layer {
			display-name = "layer1";
			bindings = <
            &kp GRAVE &kp SEMI  &kp COLON &kp QMARK       &kp SLASH             &kp BSLH         &kp MINUS           &kp EQUAL      &kp LBKT       &kp RBKT
            &kp N1    &kp N2    &kp N3    &kp N4          &kp N5                &kp N6           &kp N7              &kp N8         &kp N9         &kp N0
            &mo 4     &kp LWIN  &kp LALT  &mt LWIN BSPC   &kp RSHFT             &kp RSHFT        &mt LWIN ENTER      &kp LALT       &kp LCTRL      &mt LSHFT SQT
					  &none           &kp RSHFT             &kp RSHFT        &none
			>;
		};
		fn2_layer {
			display-name = "layer2";
			bindings = <
            &kp DEL    &kp C_PP	  &kp C_PREV &kp C_NEXT   &kp C_BRI_UP          &none        &kp C_VOL_DN  &kp C_VOL_UP &kp C_MUTE    &kp BSPC
            &kp ESC    &kp LSHFT  &mo 3      &none        &kp C_BRI_DN          &kp LEFT     &kp DOWN      &kp UP       &kp RIGHT     &kp SPACE
            &kp LSHFT  &kp LCTRL  &kp LALT   &kp LWIN     &kp LSHFT           &kp LS(LEFT) &kp LS(DOWN)  &kp LS(UP)   &kp LS(RIGHT) &mt LSHFT ENTER
					     &mo 5        &kp RSHFT           &kp RSHFT    &none
			>;
		};
		// Numbers and high frequency symbols
		fn3_layer {
			display-name = "layer3";
			bindings = <
	    &none     &none     &none    &none      &none	      &mkp MB1	     &mkp MB2        &none         &none            &msc SCRL_UP
            &none     &kp LSHFT &none    &none      &none	      &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &msc SCRL_DOWN
            &kp LSHFT &kp LCTRL &kp LALT &kp LWIN   &none	      &none          &none           &none         &none            &none
					 &none      &none             &none          &none
			>;
		};

		// Function keys with modifiers
		fn4_layer {
			display-name = "layer4";
			bindings = <
            &none     &none     &none    &none      &none	      &kp F1   &kp F2  &kp F3  &kp F4  &kp F5
            &none     &none     &none    &none      &none             &kp F6   &kp F7  &kp F8  &kp F9  &kp F10
            &kp LSHFT &kp LCTRL &kp LALT &kp LWIN   &kp RSHFT	      &kp F11  &kp F12 &none   &none   &none
					 &none      &none             &none    &none
			>;
		};

		// Main modifiers and arrow keys
		fn5_layer {
			display-name = "layer5";
			bindings = <
            &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4    	   &none        &none  &none  &none  &none
            &out OUT_USB   &out OUT_BLE   &out OUT_USB   &bt BT_CLR     &bootloader		   &bootloader  &none  &none  &none  &none
            &none          &none          &none          &none          &none    		   &none        &none  &none  &none  &none
							 &none          &none                      &none        &none
			>;
		};


		fn6_layer {
				display-name = "layer6";
				bindings = <
            &none   &none   &none   &none    &none   &none   &none   &none   &none   &none  
            &none   &none   &none   &none    &none   &none   &none   &none   &none   &none  
            &none   &none   &none   &none    &none   &none   &none   &none   &none   &none      
						&none &none &none &none
				>;
		};
	};
};
